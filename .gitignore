# ============================================================================
# OS files
# ============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ============================================================================
# Editor / IDE
# ============================================================================
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-*
.history/

# ============================================================================
# Node.js / npm / Yarn
# ============================================================================
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.npm/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
*.tgz

# ============================================================================
# TypeScript
# ============================================================================
*.tsbuildinfo
.tscache/

# ============================================================================
# Test / coverage
# ============================================================================
coverage/
.nyc_output/
junit.xml
*.lcov

# ============================================================================
# Turborepo
# ============================================================================
.turbo/

# ============================================================================
# Environment files (NEVER commit secrets)
# ============================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# ============================================================================
# Logs
# ============================================================================
logs/
*.log

# ============================================================================
# ANDROID
# ============================================================================

# Gradle build outputs
android/build/
android/app/build/
android/.gradle/
android/.cxx/
android/captures/
android/.kotlin/

# Local config (machine-specific paths)
android/local.properties

# Gradle wrapper bits we don't want (the wrapper itself in android/ should stay if present)
android/gradle/wrapper/gradle-wrapper.properties.bak

# Generated codegen output (rebuilt every build)
android/generated/

# Android Studio
*.iml
.cxx/
local.properties

# Keystore files (NEVER commit production keystores)
*.jks
*.keystore
!debug.keystore                 # debug keystore is fine to commit if present

# APK / AAB output
*.apk
*.aab
*.ap_

# Profiling
*.hprof

# ============================================================================
# iOS
# ============================================================================

# Xcode build output
ios/build/
ios/DerivedData/
build/
DerivedData/

# CocoaPods
ios/Pods/
ios/Podfile.lock                # for LIBRARIES only; in an app, you'd commit this

# Xcode user-specific files
xcuserdata/
*.xcuserstate
*.xcuserdatad/
project.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcscmblueprint
*.xccheckout

# Swift Package Manager
.swiftpm/
Package.resolved

# Fastlane (if you use it later)
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# ============================================================================
# DO NOT IGNORE — explicit allow-list for files that match broader patterns
# above but MUST be committed because they're part of the shipped library
# ============================================================================

# Your AutoBeacon Android AAR (binary artifact shipped with the library)
!android/libs/
!android/libs/*.aar

# Your AutoBeacon iOS framework (binary artifact shipped with the library)
!ios/AutoBeaconSDK.framework/
!ios/AutoBeaconSDK.framework/**

# ProGuard rules ship with the library
!android/proguard-rules.pro

# ============================================================================
# Misc
# ============================================================================
*.bak
*.tmp
.tmp/
.cache/
.npmrc