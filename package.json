{
  "name": "AutoBeaconReactNativeSample",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "npx react-native run-android",
    "android:release": "cd android && ./gradlew installRelease",
    "ios": "npx react-native run-ios",
    "start": "npx react-native start",
    "start:reset": "npx react-native start --reset-cache",
    "build:android": "npx react-native build-android --extra-params \"--no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a\"",
    "build:ios": "npx react-native build-ios --mode Debug",
    "pods": "cd ios && pod install"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-native": "0.81.5",
    "@autobeacon/autobeacon-react-native": "~0.4.1",

    "@react-native/new-app-screen": "0.81.5",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "^7.9.0",
    "@react-native-async-storage/async-storage": "^3.0.3",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/messaging": "^24.0.0",
    "react-native-ble-manager": "^12.4.5",
    "react-native-geocoding": "^0.5.0",
    "react-native-gifted-charts": "^1.4.77",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-maps": "^1.27.2",
    "react-native-paper": "^5.14.5",
    "react-native-permissions": "^5.5.1",
    "react-native-progress": "^5.0.1",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "4.19.0",
    "react-native-shared-preferences": "^1.0.2",
    "react-native-star-rating-widget": "^1.11.0",
    "react-native-svg": "^15.12.1",
    "react-native-vector-icons": "^10.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/runtime": "^7.28.4",
    "@react-native-community/cli": "^20.0.2",
    "@react-native-community/cli-platform-android": "20.0.2",
    "@react-native-community/cli-platform-ios": "20.0.2",
    "@react-native/babel-preset": "0.81.5",
    "@react-native/metro-config": "0.81.5",
    "@react-native/typescript-config": "0.81.5",
    "@types/react": "^19.1.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "react-native-builder-bob": "^0.40.17",
    "react-native-monorepo-config": "^0.3.2",
    "react-native-svg-transformer": "^1.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}